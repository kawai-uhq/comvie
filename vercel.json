{
  "rewrites": [
    {
      "source": "/title/:type/:id",
      "destination": "/api/title?type=:type&id=:id"
    },
    {
      "source": "/watch/:type/:id",
      "destination": "/api/title?type=:type&id=:id"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}